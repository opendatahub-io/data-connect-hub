# Cargo build output
target/

#local dev
.local/

# Rustfmt backup files
**/*.rs.bk

# Python
__pycache__/
*.pyc

# MSVC debugging symbols
*.pdb

# Cargo mutants output
**/mutants.out*/

# LLVM coverage artifacts
coverage/
coverage.json
*.profraw
*.profdata

# Dotdirs (allow .github/, .cargo/, and .hooks/)
.*/
!.cargo/
!.github/
!.claude/
!.hooks/
.claude/*
!.claude/CLAUDE.md

# Docs are markdown only
docs/**/
!docs/
!docs/proposals/

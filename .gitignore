# OS files
.DS_Store
Thumbs.db

# Cargo build output
target/

#local dev
.local/

# Rustfmt backup files
**/*.rs.bk

# Python
__pycache__/
*.pyc

# MSVC debugging symbols
*.pdb

# Cargo mutants output
**/mutants.out*/

# LLVM coverage artifacts
coverage/
coverage.json
*.profraw
*.profdata

# Dotdirs (allow .github/, .cargo/, and .hooks/)
.*/
!.cargo/
!.github/
!.claude/
!.hooks/
.claude/*
!.claude/CLAUDE.md

# Python SDK build artifacts
sdk/python/dist/
sdk/python/src/*.egg-info/
sdk/python/.coverage
sdk/python/htmlcov/

# Docs are markdown only
docs/**/
!docs/
!docs/proposals/
!docs/user-guide/
!docs/user-guide/**
!docs/dev-guide/
!docs/dev-guide/**

# Generated Postgres credentials (run config/db/postgres/generate-secrets.sh)
config/db/postgres/postgres-credentials.env
config/db/postgres/secret-config.toml

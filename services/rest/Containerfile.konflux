ARG RUNTIME_BASE_IMAGE=registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:5e9a0970f73f4800445c3ce0ca0d6b7ea1a8c620b81e735d16432db09d6787bc
FROM registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:5e9a0970f73f4800445c3ce0ca0d6b7ea1a8c620b81e735d16432db09d6787bc AS builder

# openssl-devel: the binary links the system OpenSSL dynamically so that
# cryptography is performed by the RHEL FIPS provider rather than a statically
# linked Rust implementation. Installing it also aligns openssl-libs with the
# runtime image. See ODH-ADR-0003.
# clang: required by bindgen (used by openssl-sys and other native bindings)
RUN microdnf install -y gcc pkgconf tar gzip findutils ca-certificates curl-minimal openssl-devel clang \
    && microdnf clean all

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    --profile minimal --default-toolchain none

WORKDIR /src

COPY rust-toolchain.toml ./
RUN rustup install
COPY Cargo.toml Cargo.lock ./
COPY libs/ ./libs/
COPY connectors/ ./connectors/
COPY services/ ./services/

RUN cargo build --release -p rest-service \
    && cp target/release/rest-service /usr/local/bin/rest-service

FROM ${RUNTIME_BASE_IMAGE}
WORKDIR /

RUN microdnf install -y ca-certificates \
    && microdnf clean all

COPY --chown=root:root --chmod=0444 \
    services/rest/openssl-fips.cnf /etc/pki/tls/openssl-fips.cnf

ENV OPENSSL_CONF=/etc/pki/tls/openssl-fips.cnf

COPY --from=builder --chown=root:root --chmod=0555 \
    /usr/local/bin/rest-service /app/rest-service

USER 1001:1001

ENTRYPOINT ["/app/rest-service"]

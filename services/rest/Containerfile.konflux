ARG RUNTIME_BASE_IMAGE=registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:f9a3f225bc0e265827d123f0e07a9f7ae5686d0cb61fa85e55fc589240543d3f

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.7@sha256:907b68736aa798b2d38255b7aa070b2a70acb90803864a40f05d0ec47556ddd0 AS builder

RUN microdnf install -y gcc pkgconf tar gzip findutils ca-certificates curl-minimal \
    && microdnf clean all

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    --profile minimal --default-toolchain none

WORKDIR /src

COPY rust-toolchain.toml ./
RUN rustup install
COPY Cargo.toml Cargo.lock ./
COPY libs/ ./libs/
COPY connectors/ ./connectors/
COPY services/ ./services/

RUN cargo build --release -p rest-service \
    && cp target/release/rest-service /usr/local/bin/rest-service

FROM ${RUNTIME_BASE_IMAGE}
WORKDIR /

RUN microdnf install -y ca-certificates \
    && microdnf clean all

COPY --from=builder --chown=root:root --chmod=0555 \
    /usr/local/bin/rest-service /app/rest-service

USER 1001:1001

ENTRYPOINT ["/app/rest-service"]

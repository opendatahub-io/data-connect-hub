ARG RUNTIME_BASE_IMAGE=registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:d638f3b49b79575329aacdae2739f954effe2467c12147711e73445c4fc97819

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.9-1794467051@sha256:baafce2d34783a28b4a472779f304e97e00f9d35c99553bc53b068b14344d9a9 AS builder

RUN microdnf install -y gcc pkgconf tar gzip unzip findutils ca-certificates curl-minimal \
    && microdnf clean all

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    --profile minimal --default-toolchain none

ARG PROTOC_VERSION=35.1
RUN case "$(uname -m)" in \
        x86_64)  PROTOC_ARCH=x86_64 ;; \
        aarch64) PROTOC_ARCH=aarch_64 ;; \
        ppc64le) PROTOC_ARCH=ppcle_64 ;; \
        s390x)   PROTOC_ARCH=s390_64 ;; \
        *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;; \
    esac \
    && curl -fsSL -o /tmp/protoc.zip \
        "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip" \
    && unzip -q /tmp/protoc.zip -d /usr/local -x readme.txt \
    && rm /tmp/protoc.zip

ENV PROTOC=/usr/local/bin/protoc

WORKDIR /src

COPY rust-toolchain.toml ./
RUN rustup install
COPY Cargo.toml Cargo.lock ./
COPY libs/ ./libs/
COPY connectors/ ./connectors/
COPY services/ ./services/

RUN cargo build --release -p flight-service \
    && cp target/release/flight-service /usr/local/bin/flight-service

FROM ${RUNTIME_BASE_IMAGE}
WORKDIR /

RUN microdnf install -y ca-certificates \
    && microdnf clean all

COPY --from=builder --chown=root:root --chmod=0555 \
    /usr/local/bin/flight-service /app/flight-service

USER 1001:1001

ENTRYPOINT ["/app/flight-service"]

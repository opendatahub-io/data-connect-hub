# e2e/env.example — Copy to env.local and fill in your values.
#
# Usage:
#   cp e2e/env.example e2e/env.local
#   $EDITOR e2e/env.local
#   ./e2e/run-e2e.sh e2e/env.local
#
# Lines starting with '#' are ignored. All values are shell-compatible.

# ---- Required (fill these in) ----

# Namespace where DCH services are deployed
DCH_SERVICE_NAMESPACE=

# Gateway host or host:port serving both REST and Flight
# (e.g. dch.apps.example.com).  TLS only.
DCH_GATEWAY_ENDPOINT=

# ---- Defaults (change if needed) ----

# Tenant namespace name (created if missing)
DCH_TENANT_ID=dch-e2e

# Namespace the allowed SA has no access to (for auth tests)
DCH_NO_ACCESS_NAMESPACE=dch-e2e-no-access

# Flight service ServiceAccount name
DCH_FLIGHT_SA=dch-flight-service-sa

# Audience for SA token
DCH_TOKEN_AUDIENCE=https://kubernetes.default.svc

# Skip TLS verification (for self-signed certs)
DCH_INSECURE=true

# PostgreSQL client image (used to seed test data)
DCH_POSTGRES_IMAGE=docker.io/library/postgres:16

# ---- Optional ----

# Flight metrics endpoint (e.g. http://127.0.0.1:19090, enables metrics tests)
# DCH_FLIGHT_METRICS_URL=

# Provide an existing token to skip SA/token creation
# DCH_AUTH_TOKEN=

# ---- AWS S3 connector (optional — enables S3 Flight tests) ----
# AWS credentials (uncomment and fill to enable S3 tests)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=ai-eng-canada
AWS_DEFAULT_REGION=us-east-2
AWS_S3_ENDPOINT=https://s3.us-east-2.amazonaws.com
# Set to "true" to seed S3 test data (default: false, skip if data already exists in shared bucket)
DCH_S3_SEED_DATASET=false
# DCH_MINIO_MC_IMAGE="minio/mc:latest"

# ---- Tenant data sources ----
# All tenant data source variables use the DCH_TENANT_ prefix.

# Tenant PostgreSQL URL (optional — enables PostgreSQL Flight tests)
# DCH_TENANT_PG_URL=postgresql://user:pass@dch-postgres.tenant-ns.svc:5432/dbname

# ---- Tenant Elasticsearch (optional — enables Elasticsearch Flight tests) ----
# DCH_TENANT_ES_URI=https://elasticsearch-master.tenant-ns.svc:9200
# DCH_TENANT_ES_NAMESPACE=tenant-ns
# DCH_TENANT_ES_USERNAME=elastic
# DCH_TENANT_ES_PASSWORD=
# DCH_TENANT_ES_CA_CERT=

# ---- Tenant Neo4j (optional — enables Neo4j Flight tests) ----
# DCH_TENANT_NEO4J_URI=bolt://neo4j.tenant-ns.svc:7687
# DCH_TENANT_NEO4J_ADMIN_PASSWORD=testpassword
# DCH_TENANT_NEO4J_USERNAME=dch_reader
# DCH_TENANT_NEO4J_PASSWORD=dch_readonly
# Admin password is required to seed Neo4j and has no default (CWE-798). It is
# passed straight through to the seed script; leave it unset to skip seeding.
# DCH_TENANT_NEO4J_ADMIN_PASSWORD=
# DCH_TENANT_NEO4J_DATABASE=neo4j

# ---- Tenant URI (optional — enables URI Flight tests) ----
# If set, uses this URL as the base URI for the connector.
# If not set, a test HTTP server is deployed automatically.
# DCH_TENANT_URI=http://my-api.tenant-ns.svc:8080
# Set to "false" to skip deploying the test server when DCH_TENANT_URI is not set
# DCH_URI_DEPLOY_SERVER=true

# ---- Tenant Milvus (optional — enables Milvus Flight tests) ----
# DCH_TENANT_MILVUS_HOST=milvus.tenant-ns.svc
# DCH_TENANT_MILVUS_PORT=19530
# DCH_TENANT_MILVUS_TOKEN=
# DCH_TENANT_MILVUS_DATABASE=default

# e2e/env.example — Copy to env.local and fill in your values.
#
# Usage:
#   cp e2e/env.example e2e/env.local
#   $EDITOR e2e/env.local
#   ./e2e/run-e2e.sh e2e/env.local
#
# Lines starting with '#' are ignored. All values are shell-compatible.

# ==============================================================================
# REQUIRED — MUST SET THESE VALUES BEFORE RUNNING E2E TESTS !!!
# ==============================================================================

# Namespace where DCH services are deployed
DCH_SERVICE_NAMESPACE=

# Gateway host or host:port serving both REST and Flight
# (e.g. dch.apps.example.com).  TLS only.
DCH_GATEWAY_ENDPOINT=

# Tenant namespace name
DCH_TENANT_ID=dch-e2e

# Flight service ServiceAccount name (required for datasource-secret RBAC)
DCH_FLIGHT_SA=dch-flight-service-sa

# REST service ServiceAccount name (required for secret-export RBAC)
DCH_REST_SA=dch-rest-service-sa

# ==============================================================================
# Optional - DCH Service
# ==============================================================================

# Skip TLS verification (set to false when using a trusted CA certificate)
# DCH_INSECURE=true

# Local CA certificate file used to verify the Gateway TLS certificate.
# Usually needed when DCH_INSECURE=false and the Gateway uses a private CA.
# DCH_CA_CERT=/path/to/gateway-ca.crt

# Audience for SA tokens. Leave empty to use the cluster default.
# DCH_TOKEN_AUDIENCE=https://kubernetes.default.svc

# Send the bearer token on health checks when testing through an authenticated platform Gateway
# DCH_GATEWAY_AUTH_REQUIRED=false

# Namespace the allowed SA has no access to (for auth tests)
# DCH_NO_ACCESS_NAMESPACE=dch-e2e-no-access

# Override the TLS authority used by the gRPC health check. Useful for a
# loopback/port-forward endpoint whose certificate name differs from the host.
# DCH_GRPC_HEALTH_AUTHORITY=

# Flight metrics endpoint (e.g. http://127.0.0.1:19090, enables metrics tests)
# DCH_FLIGHT_METRICS_URL=

# Existing bearer tokens. To bypass creation of the E2E ServiceAccounts and
# token generation, provide both tokens. Keep values only in env.local.
# DCH_AUTH_TOKEN=
# DCH_DENIED_AUTH_TOKEN=

# ==============================================================================
# Optional - PostgreSQL connector
# ==============================================================================
# DCH_TENANT_PG_URL=postgresql://<user>@dch-postgres.tenant-ns.svc:5432/dbname
# For SSL with CA verification, set sslmode in the URL and provide the CA cert file:
# DCH_TENANT_PG_URL=postgresql://<user>@dch-postgres.tenant-ns.svc:5432/dbname?sslmode=verify-ca
# DCH_TENANT_PG_CA_CERT=/path/to/ca.crt

# ==============================================================================
# Optional - AWS S3 connector
# ==============================================================================
# Set the AWS credentials, bucket, region, and endpoint to enable S3 tests.
# Keep credentials only in env.local; never commit them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=ai-eng-canada
AWS_DEFAULT_REGION=us-east-2
AWS_S3_ENDPOINT=https://s3.us-east-2.amazonaws.com
# Optional local CA certificate file for an HTTPS S3-compatible endpoint.
# AWS_S3_CA_CERT=/path/to/s3-ca.crt

# Set to "true" to seed the standard E2E objects into the bucket. Leave false
# when the objects already exist in a shared bucket.
DCH_S3_SEED_DATASET=false

# ==============================================================================
# Optional - Milvus connector
# ==============================================================================
# Milvus URI. Use the REST endpoint when TLS is enabled.
# DCH_TENANT_MILVUS_URI=http://milvus.tenant-ns.svc:19530
# TLS mode uses the REST port: https://milvus.tenant-ns.svc.cluster.local:8080
# Optional Milvus authentication token.
# DCH_TENANT_MILVUS_TOKEN=
# Optional Milvus database name.
# DCH_TENANT_MILVUS_DATABASE=default
# Local CA certificate file for the TLS endpoint.
# DCH_TENANT_MILVUS_CA_CERT=/path/to/milvus-ca.pem

# ==============================================================================
# Optional - Elasticsearch connector
# ==============================================================================
# DCH_TENANT_ES_URI=https://elasticsearch-master.tenant-ns.svc:9200
# Namespace containing the Elasticsearch Pod for API key setup.
# DCH_TENANT_ES_NAMESPACE=tenant-ns
# DCH_TENANT_ES_USERNAME=elastic
# DCH_TENANT_ES_PASSWORD=
# Local CA certificate file for the HTTPS endpoint.
# DCH_TENANT_ES_CA_CERT=/path/to/elasticsearch-ca.crt

# ==============================================================================
# Optional - Neo4j connector
# ==============================================================================
# DCH_TENANT_NEO4J_URI=neo4j+s://neo4j.tenant-ns.svc:7687
# Admin password is required when DCH_TENANT_NEO4J_URI is set because the
# runner seeds Neo4j and creates the read-only user. Keep it only in env.local.
# DCH_TENANT_NEO4J_ADMIN_PASSWORD=
# DCH_TENANT_NEO4J_USERNAME=dch_reader
# DCH_TENANT_NEO4J_PASSWORD=dch_readonly
# DCH_TENANT_NEO4J_CA_CERT=/path/to/ca.crt
# Optional database name (the Neo4j default is used when omitted).
# DCH_TENANT_NEO4J_DATABASE=neo4j

# ==============================================================================
# Optional - URI connector
# ==============================================================================
# Set to true to install the built-in HTTPS test server and seed its data.
# DCH_TENANT_URI_DEPLOY_SERVER=true

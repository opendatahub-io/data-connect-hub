ARG RUNTIME_BASE_IMAGE=registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:db10c80537d786068c7c911d7ef6ea103315d0615fa4b39b5946f7976563a8d7

FROM registry.access.redhat.com/ubi9/go-toolset:9.8-1792010711 AS builder
ARG TARGETOS=linux
ARG TARGETARCH
ARG CGO_ENABLED=1

USER root
WORKDIR /workspace

COPY dc-controller/go.mod dc-controller/go.sum ./
RUN go mod download

COPY dc-controller/ .

RUN CGO_ENABLED=${CGO_ENABLED} GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    GOEXPERIMENT=strictfipsruntime \
    go build -a -o manager cmd/main.go

FROM ${RUNTIME_BASE_IMAGE}
WORKDIR /

COPY --from=builder --chown=root:root --chmod=0555 /workspace/manager .
COPY config/ /manifests/

USER 1001:1001

ENTRYPOINT ["/manager"]

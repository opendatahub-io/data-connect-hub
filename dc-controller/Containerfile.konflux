ARG RUNTIME_BASE_IMAGE=registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:9aca95ae4e261eab848dc6abdfd08eb4c2453944232021245b2e3108eb25ae18

FROM registry.access.redhat.com/ubi9/go-toolset@sha256:82b3ce09e7442739b4e17153970d3f7cafe31f9b332966e13249364fd3aa3796 AS builder
ARG TARGETOS=linux
ARG TARGETARCH
ARG CGO_ENABLED=1

USER root
WORKDIR /workspace

COPY dc-controller/go.mod dc-controller/go.sum ./
RUN go mod download

COPY dc-controller/ .

RUN CGO_ENABLED=${CGO_ENABLED} GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    GOEXPERIMENT=strictfipsruntime \
    go build -a -o manager cmd/main.go

FROM ${RUNTIME_BASE_IMAGE}
WORKDIR /

ENV GODEBUG=fips140=only

COPY --from=builder --chown=root:root --chmod=0555 /workspace/manager .
COPY config/ /manifests/

USER 1001:1001

ENTRYPOINT ["/manager"]

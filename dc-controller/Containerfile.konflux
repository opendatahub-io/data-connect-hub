ARG RUNTIME_BASE_IMAGE=registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:5e9a0970f73f4800445c3ce0ca0d6b7ea1a8c620b81e735d16432db09d6787bc

FROM registry.access.redhat.com/ubi9/go-toolset@sha256:0e3894cea4fc077084245e8aa2befc8a7d91a4f60fbf850f0b5b555cbe62ee26 AS builder
ARG TARGETOS=linux
ARG TARGETARCH
ARG CGO_ENABLED=1

USER root
WORKDIR /workspace

COPY dc-controller/go.mod dc-controller/go.sum ./
RUN if [ -f /cachi2/cachi2.env ]; then . /cachi2/cachi2.env; fi && \
    go mod download

COPY dc-controller/ .

RUN if [ -f /cachi2/cachi2.env ]; then . /cachi2/cachi2.env; fi && \
    CGO_ENABLED=${CGO_ENABLED} GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    GOEXPERIMENT=strictfipsruntime \
    go build -a -o manager cmd/main.go

FROM ${RUNTIME_BASE_IMAGE}
WORKDIR /

ENV GOLANG_FIPS=1

COPY --from=builder --chown=root:root --chmod=0555 /workspace/manager .
COPY config/ /manifests/

LABEL name="rhoai/odh-data-connect-hub-controller-rhel9" \
      com.redhat.component="odh-data-connect-hub-controller-rhel9" \
      summary="Data Connect Hub Controller" \
      description="Manages DataConnectService resources and deploys Data Connect Hub services on OpenShift" \
      maintainer="OpenShift AI <managed-open-data-hub@redhat.com>" \
      io.k8s.display-name="Data Connect Hub Controller" \
      io.k8s.description="Manages DataConnectService resources and deploys Data Connect Hub services on OpenShift"

USER 1001:1001

ENTRYPOINT ["/manager"]
